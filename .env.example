# Copy to .env and `chmod 0600 .env` -- this file carries the dashboard
# password and, if you enable it, the Discord bot token.
#
#   cp .env.example .env && chmod 0600 .env

# ── Bind address ─────────────────────────────────────────────
# The tailnet address of this host, from `tailscale ip -4`. Must be in
# 100.64.0.0/10. Setting this to 0.0.0.0 publishes the dashboard on the public
# internet; the whole posture of this stack assumes you do not.
HERMES_BIND_ADDR=100.64.0.0

# ── Dashboard auth ───────────────────────────────────────────
HERMES_DASHBOARD_PORT=9119
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=damyr
# Generate: openssl rand -base64 24
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=CHANGE_ME
# Generate once and keep it stable, or every restart invalidates live sessions:
#   openssl rand -hex 32
#
# MUST decode to at least 16 bytes. A shorter one is not a warning: the auth
# plugin declines to register, and the dashboard then refuses to bind with
# "no auth providers are registered" -- which points at the wrong problem
# entirely. `openssl rand -hex 32` gives 32 bytes and is comfortably over.
HERMES_DASHBOARD_BASIC_AUTH_SECRET=CHANGE_ME

# ── Storage ──────────────────────────────────────────────────
# Must be owned by 10000:10000 -- `make data-dir` does this for you.
HERMES_DATA_DIR=./data

# ── Image ────────────────────────────────────────────────────
HERMES_IMAGE=hermes-agent-rtk:latest
HERMES_CONTAINER_NAME=hermes
HERMES_BRIDGE_NAME=hermes0

# ── rtk ──────────────────────────────────────────────────────
# safe | aggressive | none -- see scripts/install-shims.sh. Changing this needs
# a rebuild (`make build`); it is a build argument, not a runtime one.
RTK_SHIM_LEVEL=safe
# Runtime kill switch. Set to 1 and restart to make every shim exec the real
# binary, with no rebuild.
RTK_SHIM_DISABLED=

# ── Resources ────────────────────────────────────────────────
# Upstream suggests 2-4G. On a 1815M box this is a ceiling that leaves room for
# sshd, tailscaled and dockerd, not a recommendation.
HERMES_MEMORY_LIMIT=1200m
HERMES_CPU_LIMIT=1.5
# Browser and computer-use tools want 1g. That is tmpfs, i.e. real RAM.
HERMES_SHM_SIZE=256m

TZ=Europe/Paris
HERMES_UID=10000
HERMES_GID=10000
